# Database — SQLite for local MVP; use PostgreSQL in production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crunchadmin?schema=public"

# OpenAI (optional — chat falls back to graceful stub if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hablar mic → backend STT (Whisper). Default whisper-1.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional passphrase for destructive assistant confirms (also use CONFIRMAR <código>)
ASSISTANT_CONFIRM_SECRET=

# Auth (optional — MVP is single-operator without login)
# NextAuth
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Supabase Auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
