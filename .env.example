# Database — dual SQLite: Desarrollo (demo) vs Producción (real restaurant)
# Hostinger: file:/opt/crunchadmin/data/demo.db + file:/opt/crunchadmin/data/prod.db
DATABASE_URL_DEMO="file:./demo.db"
DATABASE_URL_PROD="file:./prod.db"
# Prisma CLI / seed default (must point at DEMO — never seed prod without asking)
DATABASE_URL="file:./demo.db"

# OpenAI (optional — chat falls back to graceful stub if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hablar mic → backend STT (Whisper batch fallback). Default whisper-1.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Hablar live STT (Realtime). Prefer gpt-live-transcribe.
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe

# Optional passphrase for destructive assistant confirms (also use CONFIRMAR <código>)
ASSISTANT_CONFIRM_SECRET=

# Auth (optional — MVP is single-operator without login)
# NextAuth
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Supabase Auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
