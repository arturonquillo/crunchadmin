# Database — SQLite for local MVP; use PostgreSQL in production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crunchadmin?schema=public"

# Public origin used inside printed QR codes (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://lecrunch.com.br"

# Required in production (NODE_ENV=production). Gates the panel and all write APIs.
# Public QR redirects (/qr/...) stay open. Single-operator: keep the password in env;
# add DB users only if you later need multi-admin.
# ADMIN_PASSWORD=

# OpenAI (optional — chat falls back to graceful stub if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
